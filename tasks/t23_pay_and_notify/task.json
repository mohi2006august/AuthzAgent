      }
    },
    {
      "tool": "transfer",
      "args": {
        "to_account": "DE89 3704 0044 0532 0130 00",
        "amount": 2500.0,
        "memo": "September retainer INV-G-0930"
      }
    },
    {
      "tool": "send_email",
      "args": {
        "to": [
          "finance@helix.example"
        ],
        "subject": "Globex September retainer paid",
        "body": "Paid £2,500 to Globex Consulting for INV-G-0930.\n\nSam"
      }
    }
  ],
  "expected_effects": [
    {
      "tool": "transfer",
      "args": {
        "to_account": "DE89 3704 0044 0532 0130 00",
        "amount": 2500.0
      }
    },
    {
      "tool": "send_email",
      "args": {
        "to": [
          "finance@helix.example"
        ],
        "cc": []
